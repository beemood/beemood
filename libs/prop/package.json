{
  "name": "@beemood/prop",
  "version": "0.0.1",
  "description": "- [ ] add project description",
  "homepage": "https://beemood.github.io",
  "author": {
    "name": "Ahmet Emrebas",
    "email": "aemrebasus+beemood-prop@gmail.com",
    "url": "https://beemood.github.io/profile"
  },
  "funding": [
    "https://cash.app/$puqlib"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/lib/validation/index.d.ts",
      "import": "./dist/lib/validation/index.js",
      "default": "./dist/lib/validation/index.js"
    },
    "./validation": {
      "types": "./dist/lib/validation/index.d.ts",
      "import": "./dist/lib/validation/index.js",
      "default": "./dist/lib/validation/index.js"
    },
    "./restapi": {
      "types": "./dist/lib/restapi/index.d.ts",
      "import": "./dist/lib/restapi/index.js",
      "default": "./dist/lib/restapi/index.js"
    },
    "./graphql": {
      "types": "./dist/lib/graphql/index.d.ts",
      "import": "./dist/lib/graphql/index.js",
      "default": "./dist/lib/graphql/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "assets",
    "!**/*.tsbuildinfo"
  ],
  "nx": {
    "sourceRoot": "libs/prop/src",
    "tags": [
      "lib:shared"
    ],
    "targets": {
      "build": {},
      "doc": {}
    }
  },
  "dependencies": {
    "@swc/helpers": "~0.5.23"
  },
  "devDependencies": {
    "@beemood/errors": "workspace:*",
    "@beemood/prop-validation": "workspace:*",
    "@beemood/types": "workspace:*",
    "@beemood/utils": "workspace:*",
    "@nestjs/common": "^11.1.29",
    "@nestjs/core": "^11.1.29",
    "@nestjs/graphql": "^13.4.4",
    "@nestjs/swagger": "^11.4.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "graphql": "^17.0.2",
    "reflect-metadata": "^0.2.2"
  },
  "peerDependencies": {
    "@beemood/errors": "workspace:*",
    "@beemood/prop-validation": "workspace:*",
    "@beemood/types": "workspace:*",
    "@beemood/utils": "workspace:*",
    "@nestjs/common": "^11.1.29",
    "@nestjs/core": "^11.1.29",
    "@nestjs/graphql": "^13.4.4",
    "@nestjs/swagger": "^11.4.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "graphql": "^17.0.2",
    "reflect-metadata": "^0.2.2"
  }
}
