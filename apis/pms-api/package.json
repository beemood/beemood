{
  "name": "@beemood/pms-api",
  "version": "0.0.1",
  "description": "- [ ] add project description",
  "homepage": "https://beemood.github.io",
  "author": {
    "name": "Ahmet Emrebas",
    "email": "aemrebasus+beemood-pms-api@gmail.com",
    "url": "https://beemood.github.io/profile"
  },
  "funding": [
    "https://cash.app/$puqlib"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./graphql": {
      "types": "./dist/graphql/index.d.ts",
      "import": "./dist/graphql/index.js",
      "default": "./dist/graphql/index.js"
    },
    "./restapi": {
      "types": "./dist/restapi/index.d.ts",
      "import": "./dist/restapi/index.js",
      "default": "./dist/restapi/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "assets",
    "!**/*.tsbuildinfo"
  ],
  "nx": {
    "sourceRoot": "apis/pms-api/src",
    "tags": [
      "app:api"
    ],
    "targets": {
      "build": {
        "options": {
          "main": "{projectRoot}/src/main.ts"
        }
      },
      "doc": {},
      "serve": {}
    }
  },
  "dependencies": {
    "@swc/helpers": "~0.5.23"
  },
  "devDependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@beemood/nestjs": "workspace:*",
    "@beemood/pms-db": "workspace:*",
    "@beemood/prisma": "workspace:*",
    "@nestjs/apollo": "^13.4.4",
    "@nestjs/common": "^11.1.29",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.29",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/graphql": "^13.4.4",
    "@nestjs/platform-express": "^11.1.29",
    "@nestjs/swagger": "^11.4.6",
    "@prisma/client": "^7.9.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "graphql-subscriptions": "^3.0.0",
    "graphql": "^17.0.2",
    "reflect-metadata": "^0.2.2"
  },
  "peerDependencies": {
    "@beemood/nestjs": "workspace:*",
    "@beemood/pms-db": "workspace:*",
    "@beemood/prisma": "workspace:*",
    "@nestjs/common": "^11.1.29",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.29",
    "@nestjs/graphql": "^13.4.4",
    "@nestjs/swagger": "^11.4.6",
    "graphql-subscriptions": "^3.0.0"
  }
}
