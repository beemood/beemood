#!/usr/bin/env bash
set -e

# Fetch top-level directory names of all staged files
# Strips filenames to leave only top-level folders (or "." for root files)
directories=$(git diff --cached --name-only | awk -F'/' '{ if (NF > 1) print $1; else print "." }' | sort -u)

# Count unique top-level directories
dir_count=$(echo "$directories" | wc -l | tr -d ' ')

if [ "$dir_count" -gt 1 ]; then
  echo -e "\033[0;31m[ERROR] Single-directory commit policy violation.\033[0m"
  echo "Your commit modifies files across multiple directories:"
  echo "$directories" | sed 's/^/  - /'
  echo ""
  echo "Please split your staged changes into separate commits per directory."
  exit 1
fi

exit 0

