{
  "name": "@beemood/prisma",
  "version": "0.0.1",
  "description": "Nestjs prisma module",
  "homepage": "https://beemood.github.io",
  "author": {
    "name": "Ahmet Emrebas",
    "email": "aemrebasus+beemood-prisma@gmail.com",
    "url": "https://beemood.github.io/profile"
  },
  "funding": [
    "https://cash.app/$puqlib"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./pg": {
      "types": "./dist/lib/pg/index.d.ts",
      "import": "./dist/lib/pg/index.js",
      "default": "./dist/lib/pg/index.js"
    },
    "./sqlite": {
      "types": "./dist/lib/sqlite/index.d.ts",
      "import": "./dist/lib/sqlite/index.js",
      "default": "./dist/lib/sqlite/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "assets",
    "!**/*.tsbuildinfo"
  ],
  "nx": {
    "sourceRoot": "mods/prisma/src",
    "tags": [
      "lib:module"
    ],
    "targets": {
      "build": {},
      "doc": {}
    }
  },
  "dependencies": {
    "@swc/helpers": "~0.5.23"
  },
  "devDependencies": {
    "@beemood/constants": "workspace:*",
    "@beemood/types": "workspace:*",
    "@beemood/utils": "workspace:*",
    "@nestjs/common": "^11.1.29",
    "@nestjs/config": "^4.0.4",
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/pg": "^8.21.0",
    "better-sqlite3": "^13.0.3",
    "pg": "^8.23.0"
  },
  "peerDependencies": {
    "@beemood/constants": "workspace:*",
    "@beemood/types": "workspace:*",
    "@beemood/utils": "workspace:*",
    "@nestjs/common": "^11.1.29",
    "@nestjs/config": "^4.0.4",
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/adapter-pg": "^7.9.1",
    "better-sqlite3": "^13.0.3",
    "pg": "^8.23.0"
  }
}
