{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "emitDeclarationOnly": true,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "vitest.config.mts",
    "prisma.config.ts",
    "src/**/*.spec.ts"
  ],
  "references": [
    {
      "path": "../../clis/prisma-plugins/tsconfig.lib.json"
    },
    {
      "path": "../../libs/prop/tsconfig.lib.json"
    }
  ]
}