generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

generator RestApiDtoGenerator {
  provider = "dto"
  type     = "restapi"
  output   = "../src/generated/restapi"
}

generator GraphqlInputGenerator {
  type     = "graphql"
  provider = "dto"
  output   = "../src/generated/graphql"
}

generator RepositoryService {
  provider = "base-service"
  output   = "../src/generated/base-service"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int       @id @default(autoincrement())
  /// @readonly()
  uuid      String    @unique @db.Uuid
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)
  isActive  Boolean?  @default(true)

  tasks    UserTask[] @relation("asiggnedTasks")
  comments Comment[]

  createdTasks     Task[]     @relation("createdTasks")
  createdUserTasks UserTask[] @relation("createdUserTasks")
  createdProjects  Project[]  @relation("createdProjects")
  createdSprints   Sprint[]   @relation("createdSprints")
}

model Project {
  id Int @id @default(autoincrement())

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)
  isActive  Boolean?  @default(true)

  name        String  @unique @db.VarChar(255)
  description String? @db.Text

  /// @moreThan(()=>new Date())
  startedAt DateTime @db.Timestamptz(6)

  /// @moreThan(startedAt)
  endedAt DateTime? @db.Timestamptz(6)

  /// @moreThan(startedAt)
  dueAt DateTime? @db.Timestamptz(6)

  sprints Sprint[]

  createdBy   User @relation("createdProjects", fields: [createdById], references: [id])
  createdById Int

  // Indexes for query performance
  @@index([startedAt])
  @@index([dueAt])
}

model Sprint {
  id Int @id @default(autoincrement())

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)
  isActive  Boolean?  @default(true)

  name        String  @unique @db.VarChar(255)
  description String? @db.Text

  project   Project @relation(fields: [projectId], references: [id])
  projectId Int

  createdBy   User @relation("createdSprints", fields: [createdById], references: [id])
  createdById Int
}

model Comment {
  id Int @id @default(autoincrement())

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)
  isActive  Boolean?  @default(true)

  comment String @db.Text

  parent   Comment   @relation("parent", fields: [parentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  parentId Int
  comments Comment[] @relation("parent")

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId Int

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  taskId Int
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  CLOSE
}

model Task {
  id Int @id @default(autoincrement())

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)
  isActive  Boolean?  @default(true)

  name        String     @unique @db.VarChar(255)
  description String?    @db.Text
  score       Int        @default(1)
  status      TaskStatus

  /// @moreThan(()=>new Date())
  startedAt DateTime @db.Timestamptz(6)

  /// @moreThan(startedAt)
  endedAt DateTime? @db.Timestamptz(6)

  /// @moreThan(startedAt)
  dueAt DateTime? @db.Timestamptz(6)

  parentTask   Task? @relation("parentTask", fields: [parentTaskId], references: [id])
  parentTaskId Int?

  subTasks Task[]    @relation("parentTask")
  comments Comment[]

  createdBy   User @relation("createdTasks", fields: [createdById], references: [id])
  createdById Int

  userTasks UserTask[]
}

model UserTask {
  id Int @id @default(autoincrement())

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  taskId Int

  user   User @relation("asiggnedTasks", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId Int

  createdBy   User @relation("createdUserTasks", fields: [createdById], references: [id])
  createdById Int

  @@unique([userId, taskId])
  @@index([taskId])
}

