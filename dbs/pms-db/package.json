{
  "name": "@beemood/pms-db",
  "version": "0.0.1",
  "description": "Project management system database",
  "homepage": "https://beemood.github.io",
  "author": {
    "name": "Ahmet Emrebas",
    "email": "aemrebasus+beemood-pms-db@gmail.com",
    "url": "https://beemood.github.io/profile"
  },
  "funding": [
    "https://cash.app/$puqlib"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/generated/prisma/client.d.ts",
      "import": "./dist/generated/prisma/client.js",
      "default": "./dist/generated/prisma/client.js"
    },
    "./browser": {
      "types": "./dist/generated/prisma/browser.d.ts",
      "import": "./dist/generated/prisma/browser.js",
      "default": "./dist/generated/prisma/browser.js"
    },
    "./models": {
      "types": "./dist/generated/prisma/models.d.ts",
      "import": "./dist/generated/prisma/models.js",
      "default": "./dist/generated/prisma/models.js"
    },
    "./enums": {
      "types": "./dist/generated/prisma/enums.d.ts",
      "import": "./dist/generated/prisma/enums.js",
      "default": "./dist/generated/prisma/enums.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "assets",
    "!**/*.tsbuildinfo"
  ],
  "nx": {
    "sourceRoot": "dbs/pms-db/src",
    "targets": {
      "build": {},
      "doc": {},
      "prisma:migrate": {
        "executor": "nx:run-commands",
        "options": {
          "commands": [
            "pnpm prisma migrate dev --name=updated"
          ],
          "cwd": "{projectRoot}"
        }
      },
      "prisma:generate": {
        "executor": "nx:run-commands",
        "options": {
          "commands": [
            "pnpm prisma generate"
          ],
          "cwd": "{projectRoot}"
        }
      },
      "prisma:reset": {
        "executor": "nx:run-commands",
        "options": {
          "commands": [
            "pnpm prisma reset"
          ],
          "cwd": "{projectRoot}"
        }
      }
    }
  },
  "dependencies": {
    "@beemood/prisma-plugins": "workspace:*",
    "@swc/helpers": "~0.5.23"
  },
  "devDependencies": {
    "@prisma/client": "^7.9.0"
  },
  "peerDependencies": {
    "@prisma/client": "^7.9.0"
  }
}
