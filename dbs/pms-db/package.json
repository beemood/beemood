{
  "name": "@beemood/pms-db",
  "version": "0.0.3",
  "description": "Project management system database",
  "homepage": "https://beemood.github.io",
  "author": {
    "name": "Ahmet Emrebas",
    "email": "aemrebasus+beemood-pms-db@gmail.com",
    "url": "https://beemood.github.io/profile"
  },
  "funding": [
    "https://cash.app/$puqlib"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/generated/prisma/client.d.ts",
      "import": "./dist/generated/prisma/client.js",
      "default": "./dist/generated/prisma/client.js"
    },
    "./client": {
      "types": "./dist/generated/prisma/client.d.ts",
      "import": "./dist/generated/prisma/client.js",
      "default": "./dist/generated/prisma/client.js"
    },
    "./browser": {
      "types": "./dist/generated/prisma/browser.d.ts",
      "import": "./dist/generated/prisma/browser.js",
      "default": "./dist/generated/prisma/browser.js"
    },
    "./models": {
      "types": "./dist/generated/prisma/models.d.ts",
      "import": "./dist/generated/prisma/models.js",
      "default": "./dist/generated/prisma/models.js"
    },
    "./enums": {
      "types": "./dist/generated/prisma/enums.d.ts",
      "import": "./dist/generated/prisma/enums.js",
      "default": "./dist/generated/prisma/enums.js"
    },
    "./restapi": {
      "types": "./dist/generated/restapi/index.d.ts",
      "import": "./dist/generated/restapi/index.js",
      "default": "./dist/generated/restapi/index.js"
    },
    "./graphql": {
      "types": "./dist/generated/graphql/index.d.ts",
      "import": "./dist/generated/graphql/index.js",
      "default": "./dist/generated/graphql/index.js"
    },
    "./service": {
      "types": "./dist/generated/service/index.d.ts",
      "import": "./dist/generated/service/index.js",
      "default": "./dist/generated/service/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "assets",
    "!**/*.tsbuildinfo"
  ],
  "nx": {
    "sourceRoot": "dbs/pms-db/src",
    "tags": [
      "app:db"
    ],
    "targets": {
      "build": {},
      "doc": {},
      "prisma:migrate": {},
      "prisma:generate": {},
      "prisma:reset": {},
      "prisma:clean": {
        "executor": "nx:run-commands",
        "options": {
          "command": "rm -rf ./src/generated/*",
          "cwd": "{projectRoot}"
        }
      }
    }
  },
  "dependencies": {
    "@swc/helpers": "~0.5.23"
  },
  "devDependencies": {
    "@beemood/nestjs": "workspace:*",
    "@beemood/prisma-plugins": "workspace:*",
    "@prisma/client": "^7.9.0"
  },
  "peerDependencies": {}
}
